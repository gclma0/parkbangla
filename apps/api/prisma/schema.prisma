generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessType {
  GATE_CODE
  GUARD
  REMOTE
}

enum VerifiedStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingType {
  COMMUTER_PASS
  INSTANT
}

enum TxType {
  TOPUP
  CHARGE
  PAYOUT
  COMMISSION
  REFUND
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  fcmToken      String?
  nidDocUrl     String?
  dlDocUrl      String?
  kycStatus     KycStatus @default(NOT_SUBMITTED)
  kycRejectionReason String?
  isAdmin       Boolean   @default(false)
  idVerified    Boolean   @default(false)
  ratingAvg     Float     @default(0)
  ratingCount   Int       @default(0)
  acceptanceRate Float    @default(0)
  cancellationRate Float  @default(0)
  responseMinutesAvg Int?
  walletBalance Float     @default(0)
  locale        String    @default("en")
  createdAt     DateTime  @default(now())
  vehicles      Vehicle[]
  spots         ParkingSpot[]
  bookings      Booking[]     @relation("RenterBookings")
  reviewsFrom   Review[]      @relation("ReviewsFrom")
  reviewsTo     Review[]      @relation("ReviewsTo")
  disputes      Dispute[]
  notifications Notification[]
  ledger        WalletLedger[]
  reports       Report[]
  favorites     FavoriteSpot[]
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Vehicle {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plate     String
  type      String
  sizeClass String
  bookings  Booking[]
}

model ParkingSpot {
  id             String         @id @default(cuid())
  hostId         String
  host           User           @relation(fields: [hostId], references: [id], onDelete: Cascade)
  lat            Float
  lng            Float
  address        String
  area           String
  covered        Boolean        @default(false)
  widthM         Float?
  lengthM        Float?
  vehicleSizes   String         @default("sedan,suv")
  accessType     AccessType     @default(GUARD)
  accessNotes    String?
  photos         String[]
  entrancePhotoUrl String?
  bayPhotoUrl      String?
  ownershipProofUrl String?
  verifiedStatus VerifiedStatus @default(UNVERIFIED)
  verificationChecklist String[] @default([])
  verificationNotes String?
  rejectionReason String?
  verifiedAt     DateTime?
  resubmittedAt  DateTime?
  duplicateCandidateIds String[] @default([])
  autoApprove    Boolean        @default(true)
  hourlyPrice    Float
  dailyPrice     Float
  monthlyPrice   Float
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  availability   Availability[]
  blocks         SpotBlock[]
  bookings       Booking[]
  favoritedBy    FavoriteSpot[]

  @@index([active, lat, lng])
  @@index([active, area])
  @@index([hostId, active])
  @@index([verifiedStatus])
}

model FavoriteSpot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotId    String
  spot      ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, spotId])
  @@index([userId, createdAt])
  @@index([spotId])
}

model Availability {
  id        String      @id @default(cuid())
  spotId    String
  spot      ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  weekdays  Int[]
  startTime String
  endTime   String

  @@index([spotId])
}

model SpotBlock {
  id        String      @id @default(cuid())
  spotId    String
  spot      ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?

  @@index([spotId, startAt, endAt])
}

model Booking {
  id          String        @id @default(cuid())
  spotId      String
  spot        ParkingSpot   @relation(fields: [spotId], references: [id])
  renterId    String
  renter      User          @relation("RenterBookings", fields: [renterId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id])
  type        BookingType   @default(COMMUTER_PASS)
  status      BookingStatus @default(PENDING)
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  weekdays    Int[]
  startTime   String
  endTime     String
  amount      Float
  pin         String
  qrToken     String        @unique
  createdAt   DateTime      @default(now())
  transactions Transaction[]
  reviews     Review[]
  disputes    Dispute[]
  checkIns    CheckIn[]
  messages    Message[]

  @@index([spotId, status, startDate, endDate])
  @@index([renterId, status, createdAt])
}

model CheckIn {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind       String
  at         DateTime @default(now())
}

model Transaction {
  id        String   @id @default(cuid())
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  userId    String
  amount    Float
  method    String
  type      TxType
  status    TxStatus @default(SUCCESS)
  createdAt DateTime @default(now())
}

model WalletLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  reason    String
  bookingId String?
  createdAt DateTime @default(now())
}

model Review {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User    @relation("ReviewsFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User    @relation("ReviewsTo", fields: [toUserId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User          @relation(fields: [raisedById], references: [id])
  status      DisputeStatus @default(OPEN)
  resolution  String?
  notes       String
  createdAt   DateTime      @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  bookingId String?
  type      String?
  createdAt DateTime @default(now())
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  targetType String
  targetId   String
  reason     String
  createdAt  DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  createdAt DateTime @default(now())
}
